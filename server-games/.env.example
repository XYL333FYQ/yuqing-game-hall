# 仅用于**本地**手动起服务调试（docker compose -f docker-compose.example.yml）。
#
# 正式部署不要复制这个文件到 VPS：deploy-vps.yml 每次都会从 GitHub
# Variables / Secrets 生成 /opt/yuqing-game-hall/server-games/.env 并原子替换，
# 手写的内容会被下一次部署覆盖。要改配置请改 GitHub 上的 Variables / Secrets。
#
# Cloudflare 游戏厅的公开 Origin；多个来源用英文逗号分隔。
ALLOWED_ORIGINS=https://games.example.com

# ---- 自建 WebRTC 基础设施（webrtc-gateway + coturn）----
#
# coturn 对外服务的 DNS 名称和 VPS 公网 IPv4。
# TURN_PUBLIC_HOST 会写进签发给浏览器的 ICE 配置，必须能被玩家解析到这台 VPS。
TURN_PUBLIC_HOST=turn.example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=turn.example.com
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# gateway 与 coturn 必须使用完全相同的随机密钥；至少 32 个字符。
# 这是整套 WebRTC 基础设施里唯一的密钥，浏览器永远拿不到它。
# 生成：openssl rand -hex 32
TURN_SHARED_SECRET=replace-with-a-long-random-secret-before-deploy
# 短期 TURN 凭据的有效秒数（300–86400）。
TURN_CREDENTIAL_TTL_SECONDS=3600

# 可选：固定 coturn 镜像版本。
# COTURN_IMAGE=coturn/coturn:4.6.3
