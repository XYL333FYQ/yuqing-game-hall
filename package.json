{
  "name": "yuqing-game-hall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "games:catalog": "node scripts/generate-game-catalog.mjs",
    "build:fruit-party": "node scripts/build-fruit-party.mjs",
    "games:build": "node scripts/build-games.mjs",
    "prepare-assets": "npm run games:catalog && npm run games:build && node scripts/copy-mediapipe-assets.mjs && node scripts/copy-legal-assets.mjs && node scripts/check-game-assets.mjs",
    "check:games": "node scripts/check-game-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite --host 0.0.0.0",
    "dev:launcher": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare-assets",
    "build": "npm run check && vite build && node scripts/check-deploy-limits.mjs && wrangler deploy --dry-run --outdir output/wrangler-check && node scripts/check-worker-bundle.mjs output/wrangler-check",
    "check": "npm run games:catalog && tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check:games:types": "tsc -p tsconfig.games.json --noEmit",
    "pretest": "npm run games:catalog",
    "test": "npm run check:games:types && vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "perfect-freehand": "1.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  }
}
