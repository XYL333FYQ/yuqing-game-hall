{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "fruit-party-multiplayer",
  "main": "source/server/worker.ts",
  "compatibility_date": "2026-08-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
